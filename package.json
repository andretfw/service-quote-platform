{
  "name": "service-quote-platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Configurable quote-to-lead platform for service businesses.",
  "repository": {
    "type": "git",
    "url": "https://github.com/andretfw/service-quote-platform.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/**/*.test.ts",
    "validate:engine": "tsx scripts/validate-engine.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "ci": "npm run check && npm run build",
    "config:check": "node --env-file-if-exists=.env.local scripts/check-config.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.22.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.5.3",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  }
}
